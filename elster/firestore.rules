rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'score', 'stage', 'diff', 'char', 'updated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 16
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score < 100000
        && request.resource.data.stage is int
        && (resource == null || request.resource.data.score >= resource.data.score);
    }
  }
}
