[
  {"id": "01", "at": 2.05,  "text": "מיליוני מטופלים."},
  {"id": "02", "at": 4.05,  "text": "אינספור רגעים רפואיים."},
  {"id": "03", "at": 5.95,  "text": "עולם שלם של מידע."},
  {"id": "04", "at": 12.1,  "text": "כל רגע מְיַצֵּר מידע."},
  {"id": "05", "at": 15.1,  "text": "וכל אירוע הוא הזדמנות ליצור ערך."},
  {"id": "06", "at": 18.0,  "text": "מערכות שונות. סביבות שונות. מקורות מידע רבים."},
  {"id": "07", "at": 23.1,  "text": "ומה אם הכול היה יכול להתחבר?"},
  {"id": "08", "at": 28.6,  "text": "הכירו את נֶקְסוּס."},
  {"id": "09", "at": 29.8,  "text": "פלטפורמת הנתונים של כְּלָלִית."},
  {"id": "10", "at": 31.1,  "text": "עידן חדש של מידע."},
  {"id": "11", "at": 34.8,  "text": "אוספים אירועים מכל מערכות המקור."},
  {"id": "12", "at": 38.5,  "text": "מְחַבְּרִים. מְאַחֲדִים. מְטַיְּבִים."},
  {"id": "13", "at": 42.2,  "text": "אמת ארגונית אחת."},
  {"id": "14", "at": 45.9,  "text": "המידע הנכון, במקום הנכון, בזמן הנכון."},
  {"id": "15", "at": 50.3,  "text": "תוצאת בדיקה מוכנה, והופכת לאירוע."},
  {"id": "16", "at": 52.45, "text": "האירוע זורם דרך נֶקְסוּס, וכל מערכת מגיבה לו בעצמה."},
  {"id": "17", "at": 56.0,  "text": "אירוע אחד."},
  {"id": "18", "at": 57.0,  "text": "מערכות רבות."},
  {"id": "19", "at": 58.0,  "text": "אינספור אפשרויות."},
  {"id": "20", "at": 60.3,  "text": "מידע בתנועה. ארגון בתנועה."},
  {"id": "21", "at": 62.15, "text": "מידע בזמן אמת. פחות מורכבות. פיתוח מהיר יותר."},
  {"id": "22", "at": 66.6,  "text": "תפעול חכם יותר. רפואה מְחֻבֶּרֶת יותר. מחקר מתקדם."},
  {"id": "23", "at": 71.1,  "text": "ובסיס חזק לבינה מלאכותית."},
  {"id": "24", "at": 75.5,  "text": "ממערכות נפרדות, לארגון מְחֻבָּר."},
  {"id": "25", "at": 77.1,  "text": "ממידע, לתובנות."},
  {"id": "26", "at": 78.6,  "text": "מתובנות, להשפעה."},
  {"id": "27", "at": 79.85, "text": "אנחנו לא רק משנים את הדרך שבה מידע זורם."},
  {"id": "28", "at": 82.3,  "text": "אנחנו משנים את כללי המשחק."},
  {"id": "29", "at": 86.6,  "text": "נֶקְסוּס. מְחַבְּרִים מידע. יוֹצְרִים השפעה."}
]
